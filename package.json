{
  "name": "pw-ladder",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build && node -e \"require('fs').copyFileSync('dist/index.html','dist/404.html')\"",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "server:typecheck": "tsc -p server/tsconfig.json",
    "server:dev": "node --import tsx server/src/index.ts",
    "server:build": "esbuild server/src/index.ts --bundle --platform=node --format=esm --target=node20 --outfile=server/dist/index.mjs --external:pg-native --banner:js=\"import{createRequire}from'module';const require=createRequire(import.meta.url);\"",
    "test": "vitest run"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.13",
    "typescript": "^5.4.0",
    "vite": "^5.2.0",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@supabase/supabase-js": "^2.45.0",
    "fastify": "^5.12.4",
    "pg": "^8.23.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  }
}
